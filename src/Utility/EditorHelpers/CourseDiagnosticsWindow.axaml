<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:util="using:SMM2SaveEditor.Utility"
        x:Class="SMM2SaveEditor.Utility.EditorHelpers.CourseDiagnosticsWindow"
        Title="Course Health &amp; Corruption Diagnostics"
        Width="740" Height="580"
        MinWidth="600" MinHeight="450"
        Background="#131417"
        WindowStartupLocation="CenterOwner">
    <DockPanel Margin="16">
        <!-- Top Status Banner -->
        <Border DockPanel.Dock="Top" Name="StatusBanner" Background="#1C1E26" BorderBrush="#2A2D3C" BorderThickness="1" CornerRadius="8" Padding="16,14" Margin="0,0,0,12">
            <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                    <TextBlock Name="SlotTitleText" Text="Slot 000 (1-1): Untitled" FontSize="16" FontWeight="Bold" Foreground="#FFFFFF"/>
                    <TextBlock Name="StatusHeadingText" Text="Integrity Check Status" FontSize="13" FontWeight="SemiBold" Foreground="#F39C12"/>
                </StackPanel>

                <!-- Status Badge -->
                <Border Grid.Row="0" Grid.Column="1" Name="StatusPill" Background="#4A3210" BorderBrush="#E67E22" BorderThickness="1" CornerRadius="6" Padding="10,4" VerticalAlignment="Center">
                    <TextBlock Name="StatusPillText" Text="⚠️ Hidden in Coursebot" FontSize="12" FontWeight="Bold" Foreground="#F39C12"/>
                </Border>

                <!-- Detailed Explanation Text -->
                <TextBlock Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Name="StatusExplanationText" 
                           Text="Course data is valid, but hidden in Coursebot because save.dat marks this slot as inactive." 
                           Foreground="#A4ADC2" FontSize="11" TextWrapping="Wrap" Margin="0,10,0,0"/>
            </Grid>
        </Border>

        <!-- Bottom Action Bar -->
        <Border DockPanel.Dock="Bottom" Background="#1C1E26" BorderBrush="#2A2D3C" BorderThickness="1" CornerRadius="8" Padding="12,10" Margin="0,12,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="8">
                    <Button Name="UnhideButton" Content="👁️ Unhide in Coursebot" Classes="accent" Click="OnUnhideClick"/>
                    <Button Name="RepairThumbButton" Content="🛠️ Repair Thumbnail Signature" Classes="toolbarBtn" Click="OnRepairThumbClick"/>
                </StackPanel>

                <Button Grid.Column="2" Content="Close" Click="OnCloseClick"/>
            </Grid>
        </Border>

        <!-- Main Diagnostics Checklist -->
        <Border Background="#16171D" BorderBrush="#242735" BorderThickness="1" CornerRadius="8" Padding="8">
            <DockPanel>
                <Border DockPanel.Dock="Top" Padding="8,4,8,8" BorderThickness="0,0,0,1" BorderBrush="#242735">
                    <TextBlock Text="SMM2 ENGINE INTEGRITY &amp; CORRUPTION CHECKS" FontWeight="Bold" FontSize="11" Foreground="{StaticResource SmmYellowBrush}" LetterSpacing="1"/>
                </Border>

                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl Name="ChecksList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate x:DataType="util:DiagnosticItem">
                                <Border Margin="4,3" Padding="10,8" Background="#1D202B" BorderBrush="#2B3042" BorderThickness="1" CornerRadius="6">
                                    <Grid ColumnDefinitions="36,*,Auto" RowDefinitions="Auto,Auto">
                                        <!-- Severity Icon -->
                                        <TextBlock Grid.Row="0" Grid.RowSpan="2" Grid.Column="0" Text="{Binding Icon}" FontSize="18" VerticalAlignment="Center" HorizontalAlignment="Center"/>

                                        <!-- Check Name and Status Message -->
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding Name}" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF"/>
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding Message}" FontWeight="SemiBold" FontSize="11" Foreground="#A4ADC2"/>

                                        <!-- Technical Detail / Rationale -->
                                        <TextBlock Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding Details}" FontSize="10" Foreground="#7A8398" TextWrapping="Wrap" Margin="0,3,0,0"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </ScrollViewer>
            </DockPanel>
        </Border>
    </DockPanel>
</Window>
