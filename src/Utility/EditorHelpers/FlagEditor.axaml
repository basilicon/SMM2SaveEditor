<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
             x:Class="SMM2SaveEditor.Utility.EditorHelpers.FlagEditor">
	<Grid RowDefinitions="Auto,Auto">
		<DockPanel Grid.Row="0" Margin="0,0,0,5">
			<Button DockPanel.Dock="Right" Name="ToggleExpand" Margin="5,0,0,0" VerticalAlignment="Center">
				Expand
			</Button>
			<ContentControl Name="FlagSummaryArea"/>
		</DockPanel>
		<ContentControl Grid.Row="1" Name="FlagEditorArea"/>
	</Grid>
</UserControl>
